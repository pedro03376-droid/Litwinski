{
  "rules": {
    "clubs": {
      "$club": {
        ".read":  "auth != null && root.child('clubMembers').child($club).child(auth.uid).val() === true",
        ".write": "auth != null && root.child('clubMembers').child($club).child(auth.uid).val() === true",

        "clubinfo": {
          ".validate": "newData.hasChildren()",
          "nome":    { ".validate": "newData.isString() && newData.val().length <= 120" },
          "display": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "cidade":  { ".validate": "newData.isString() && newData.val().length <= 120" },
          "estado":  { ".validate": "newData.isString() && newData.val().length <= 40"  },
          "pais":    { ".validate": "newData.isString() && newData.val().length <= 60"  },
          "cor1":    { ".validate": "newData.isString() && newData.val().length <= 32"  },
          "cor2":    { ".validate": "newData.isString() && newData.val().length <= 32"  },
          "escudo":  { ".validate": "newData.isString() && newData.val().length <= 400000" },
          "$outro":  { ".validate": "!newData.isString() || newData.val().length <= 20000" }
        },

        "backups": {
          "latest": { ".validate": "newData.hasChildren()" },
          "history": {
            "$dia": { ".validate": "$dia.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren()" }
          },
          "$outro": { ".validate": "!newData.isString() || newData.val().length <= 20000" }
        },

        "goleiras":     { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 400000" } } },
        "pen_fotos":    { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 400000" } } },
        "aianalyses":   { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 100000" } } },

        "partidas":     { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "scouts":       { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "lesoes":       { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "pid":          { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "notifications":{ "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "tp_sessions":  { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "tp_exercises": { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "tp_goals":     { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "seasons":      { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "competicoes":  { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "def_lances":   { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "penaltis":     { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "reacao":       { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "reacao_hist":  { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "periodizacao": { "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },

        "$desconhecido": { ".validate": "!newData.isString() || newData.val().length <= 20000" }
      }
    },

    "_comentario_acesso": "clubOwners define o DONO de cada clube. Enquanto um clube NAO tem dono, tudo funciona como antes: quem tem o codigo entra sozinho. Assim que o dono ativa a aprovacao (reivindica a posse), so ELE libera novos membros.",

    "clubOwners": {
      "$club": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid && (!root.child('clubMembers').child($club).exists() || root.child('clubMembers').child($club).child(auth.uid).val() === true)",
        ".validate": "newData.isString() && newData.val().length <= 128"
      }
    },

    "clubMembers": {
      "$club": {
        ".read": "auth != null && data.child(auth.uid).val() === true",
        "$uid": {
          ".read":  "auth != null && (auth.uid === $uid || root.child('clubOwners').child($club).val() === auth.uid)",
          ".write": "auth != null && (root.child('clubOwners').child($club).val() === auth.uid || (auth.uid === $uid && !root.child('clubOwners').child($club).exists()))",
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "clubPeople": {
      "$club": {
        ".read": "auth != null && (root.child('clubOwners').child($club).val() === auth.uid || root.child('clubMembers').child($club).child(auth.uid).val() === true)",
        "$uid": {
          ".read":  "auth != null && (auth.uid === $uid || root.child('clubOwners').child($club).val() === auth.uid)",
          ".write": "auth != null && (auth.uid === $uid || root.child('clubOwners').child($club).val() === auth.uid)",
          ".validate": "newData.hasChildren(['ts'])",
          "nome":  { ".validate": "newData.isString() && newData.val().length <= 120" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "ts":    { ".validate": "newData.isNumber()" },
          "$outro": { ".validate": "!newData.isString() || newData.val().length <= 200" }
        }
      }
    },

    "registry": {
      ".read": "auth != null && auth.token.email === 'pedro03376@gmail.com'",
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || auth.token.email === 'pedro03376@gmail.com')",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren()",
        "$campo": { ".validate": "!newData.isString() || newData.val().length <= 2000" }
      }
    },

    ".read": false,
    ".write": false
  }
}
