{
  "rules": {
    "clubs": {
      "$club": {
        ".read":  "auth != null && root.child('clubMembers').child($club).child(auth.uid).val() === true",
        ".write": "auth != null && root.child('clubMembers').child($club).child(auth.uid).val() === true",

        "clubinfo": {
          ".validate": "newData.hasChildren()",
          "nome":    { ".validate": "newData.isString() && newData.val().length <= 120" },
          "display": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "cidade":  { ".validate": "newData.isString() && newData.val().length <= 120" },
          "estado":  { ".validate": "newData.isString() && newData.val().length <= 40"  },
          "pais":    { ".validate": "newData.isString() && newData.val().length <= 60"  },
          "cor1":    { ".validate": "newData.isString() && newData.val().length <= 32"  },
          "cor2":    { ".validate": "newData.isString() && newData.val().length <= 32"  },
          "escudo":  { ".validate": "newData.isString() && newData.val().length <= 400000" },
          "$outro":  { ".validate": "!newData.isString() || newData.val().length <= 20000" }
        },

        "backups": {
          "latest":  { ".validate": "newData.hasChildren()" },
          "history": {
            ".validate": "newData.numChildren() <= 40",
            "$dia": { ".validate": "$dia.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren()" }
          },
          "$outro": { ".validate": false }
        },

        "goleiras":     { ".validate": "newData.numChildren() <= 500",   "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 400000" } } },
        "partidas":     { ".validate": "newData.numChildren() <= 5000",  "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "scouts":       { ".validate": "newData.numChildren() <= 20000", "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "lesoes":       { ".validate": "newData.numChildren() <= 5000",  "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "pid":          { ".validate": "newData.numChildren() <= 5000",  "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "aianalyses":   { ".validate": "newData.numChildren() <= 2000",  "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 100000" } } },
        "notifications":{ ".validate": "newData.numChildren() <= 2000",  "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "tp_sessions":  { ".validate": "newData.numChildren() <= 10000", "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "tp_exercises": { ".validate": "newData.numChildren() <= 10000", "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "tp_goals":     { ".validate": "newData.numChildren() <= 5000",  "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "seasons":      { ".validate": "newData.numChildren() <= 500",   "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "competicoes":  { ".validate": "newData.numChildren() <= 1000",  "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "def_lances":   { ".validate": "newData.numChildren() <= 50000", "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "penaltis":     { ".validate": "newData.numChildren() <= 20000", "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "pen_fotos":    { ".validate": "newData.numChildren() <= 2000",  "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 400000" } } },
        "reacao":       { ".validate": "newData.numChildren() <= 20000", "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "reacao_hist":  { ".validate": "newData.numChildren() <= 50000", "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },
        "periodizacao": { ".validate": "newData.numChildren() <= 5000",  "$id": { ".validate": "newData.hasChildren()", "$campo": { ".validate": "!newData.isString() || newData.val().length <= 20000" } } },

        "$desconhecido": { ".validate": "!newData.isString() || newData.val().length <= 20000" }
      }
    },

    "clubMembers": {
      "$club": {
        ".read": "auth != null && data.child(auth.uid).val() === true",
        "$uid": {
          ".read":     "auth != null && auth.uid === $uid",
          ".write":    "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "registry": {
      ".read": "auth != null && auth.token.email === 'pedro03376@gmail.com'",
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || auth.token.email === 'pedro03376@gmail.com')",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren()",
        "$campo": { ".validate": "!newData.isString() || newData.val().length <= 2000" }
      }
    },

    ".read": false,
    ".write": false
  }
}
